@custom-variant dark (&:is(.dark *));

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-heading: var(--font-commissioner), system-ui, sans-serif;
  --font-caption: var(--font-pt-caption), system-ui, sans-serif;
  --font-sans: var(--font-mulish), system-ui, sans-serif;
  /* Бренд */
  --color-brand: #ed8e33;        /* основной акцент — CTA, активные состояния, иконки */
  --color-brand-dark: #d67a22;   /* hover/active на brand-элементах, тени */
  --color-brand-light: #fdf1e3;  /* очень светлый tint — фоны бейджей, hover-подложки */

  /* База */
  --color-ink: #0a0a0a;          /* не чистый #000 — мягче для больших плашек текста/фона */
  --color-paper: #ffffff;

  /* Нейтральная шкала — используйте готовую zinc/stone из Tailwind, она у вас уже в ходу */

